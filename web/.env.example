# Copy to .env.local for local dev.
# For production, add these in the Vercel dashboard → Settings → Environment Variables.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AI...
PERPLEXITY_API_KEY=pplx-...

# Vercel Blob — for saving & sharing searches.
# Created automatically when a Blob store is connected to the Vercel project;
# pull it locally with `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
