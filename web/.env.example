# ── AI providers ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...
PERPLEXITY_API_KEY=pplx-...

# ── Supabase ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. Bypasses RLS — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Access ───────────────────────────────────────────────────────────────
# One shared secret. The iOS Shortcut sends it as a bearer token, and the web
# UI exchanges it for a session cookie. Generate with:
#   openssl rand -base64 32
CAPTURE_SECRET=

# ── Job queue (Upstash QStash) ───────────────────────────────────────────
# Optional in local development: without QSTASH_TOKEN, jobs are dispatched as
# direct fire-and-forget HTTP calls with no retries. Required in production.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Deployment ───────────────────────────────────────────────────────────
# Absolute base URL used to build job callback URLs and share links.
# Falls back to VERCEL_URL, then localhost.
APP_URL=https://your-app.vercel.app
